# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-...
# The chat agent model.
AGENT_MODEL=main-chat-model-id

# The separate GuardrailAgent model. If omitted, AGENT_MODEL is reused.
GUARD_MODEL=guard-model-id

LOG_API_URL=https://guarded-agent-logs.<your-subdomain>.workers.dev
LOG_API_KEY=<the INGEST_KEY secret you set on the worker>
