# Supply-chain hardening: refuse to install npm packages younger than 7 days.
# - npm 11.10.0+ honours `min-release-age` here.
# - pnpm 10.16+ honours `minimum-release-age` (camelCase in pnpm config, kebab here is read by npm).
# - Yarn 4.10+ reads `npmMinimalAgeGate` from .yarnrc.yml separately.
# Bump to `0` only with a documented exception.
min-release-age=10080
minimum-release-age=10080
